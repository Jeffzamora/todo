{
  "info": {
    "name": "Todo Pro API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/todo/public"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "cronKey",
      "value": "CHANGE_ME"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"demo\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Users Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Users Update Me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jefferson\",\n  \"apellido\": \"Zamora\",\n  \"email\": \"nuevo@email.com\"\n}"
            }
          }
        },
        {
          "name": "Users Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/me/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Payaso25.\",\n  \"new_password\": \"NuevaClaveSegura123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Tasks List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/tasks"
      }
    },
    {
      "name": "Shopping Lists",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/shopping/lists"
      }
    },
    {
      "name": "Cron Recurring Run",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/cron/recurring/run?key={{cronKey}}&limit=50"
      }
    }
  ]
}